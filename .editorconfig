root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{cs,ps1,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# The imported EDoc helpers are tracked verbatim.
[backend/src/AiNexus.Api/Database/EDoc/**]
trim_trailing_whitespace = false
insert_final_newline = unset
