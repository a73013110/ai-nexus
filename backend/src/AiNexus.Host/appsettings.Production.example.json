{
  "AllowedHosts": "ai-nexus.company.internal",
  "Databases": {
    "App": {
      "Server": "sql.company.internal",
      "TrustServerCertificate": true
    }
  },
  "Identity": {
    "ActiveDirectory": {
      "Domain": "company.internal",
      "BindUser": "directory-reader"
    },
    "Bootstrap": {
      "Administrators": []
    }
  },
  "AccessControl": {
    "NavigationLinkHosts": [
      "intranet.company.internal",
      "*.docs.company.internal"
    ]
  },
  "Files": {
    "StoragePath": "D:\\CoreProject\\AiNexus\\data\\attachments"
  },
  "Diagnostics": {
    "Directory": "D:\\CoreProject\\AiNexus\\data\\diagnostics"
  },
  "Mail": {
    "Transport": "Smtp",
    "From": {
      "Address": "no-reply@company.internal"
    },
    "PublicBaseUrl": "https://ai-nexus.company.internal",
    "Smtp": {
      "Host": "smtp.company.internal",
      "Port": 587,
      "Security": "StartTls"
    }
  }
}
