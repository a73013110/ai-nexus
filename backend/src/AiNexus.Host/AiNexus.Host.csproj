<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Host only: configuration, middleware pipeline, module composition and operational commands. -->
  <PropertyGroup>
    <RootNamespace>AiNexus.Host</RootNamespace>
    <UserSecretsId>ai-nexus-api-v1-local</UserSecretsId>
    <!--
      只影響還原：讓 Build.ps1 跳過還原、直接發布指定平台。不指定平台時，SqlClient、MSAL 等套件會把所有平台的原生檔
      （linux-x64 的 libmsalruntime.so 就有 37 MB）都放進 runtimes/。build 與測試不受影響。
    -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AiNexus.Platform/AiNexus.Platform.csproj" />
    <ProjectReference Include="../AiNexus.Data/AiNexus.Data.csproj" />
    <ProjectReference Include="../AiNexus.Features/AiNexus.Features.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <!--
    XML 文件只為了 build 的 unused-using 檢查而產生，是寫給維護者的，不能變成 OpenAPI 說明，所以移除 OpenAPI 的 XML 註解產生器。
    不用 Condition 屬性：dotnet new 範本會把 csproj 的 Condition 當成範本條件評估，fork 時整行被刪掉。
  -->
  <Target Name="ExcludeXmlDocsFromOpenApi" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer->WithMetadataValue('Filename', 'Microsoft.AspNetCore.OpenApi.SourceGenerators'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Secrets.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Staging.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.*.example.json" CopyToPublishDirectory="Never" />
    <Content Update="web.config" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
