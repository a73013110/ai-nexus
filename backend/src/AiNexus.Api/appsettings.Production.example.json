{
  "ConfigurationVersion": 2,
  "AllowedHosts": "ai-nexus.company.internal",
  "Database": {
    "Server": "192.168.2.95",
    "Name": "AiNexus",
    "TrustServerCertificate": true,
    "ConnectTimeoutSeconds": 10
  },
  "AdAuthentication": {
    "Mode": "Ldap",
    "Url": "ad.company.internal/DC=company,DC=internal",
    "Domain": "company.internal",
    "DnUser": "CN=directory-reader,CN=Users,DC=company,DC=internal",
    "AdAccountAttrName": "sAMAccountName"
  },
  "Administration": {
    "BootstrapAdministrators": []
  },
  "DataProtection": {},
  "Security": {
    "DisableHttpsRedirection": false
  },
  "Inference": {
    "Provider": "google",
    "Execution": {
      "QueueCapacity": 16,
      "TimeoutSeconds": 300,
      "MaxInputCharacters": 12000,
      "MaxOutputCharacters": 65536
    },
    "ModelPolicy": {
      "AllowModelSelection": true,
      "ShowModelNames": true
    },
    "Providers": {
      "Google": {
        "DefaultModelId": "gemma-4-26b-a4b-it",
        "Models": {
          "default": {
            "Id": "gemma-4-26b-a4b-it",
            "DisplayName": "Gemma 4 · Google AI",
            "ContextTokens": 32768,
            "MaxOutputTokens": 4096,
            "SupportsStreaming": true,
            "SupportsUsage": true,
            "SupportsImages": true,
            "ReasoningControl": "google-level",
            "ReasoningEfforts": ["minimal", "high"],
            "DefaultReasoningEffort": "minimal"
          }
        }
      },
      "Ollama": {
        "Endpoint": "http://localhost:11434/",
        "DefaultModelId": "qwen3:8b",
        "Models": {
          "default": {
            "Id": "qwen3:8b",
            "DisplayName": "Qwen 3 · 本地",
            "ContextTokens": 8192,
            "MaxOutputTokens": 2048,
            "SupportsStreaming": true,
            "SupportsUsage": true,
            "SupportsImages": false,
            "ReasoningControl": "ollama-toggle",
            "ReasoningEfforts": ["minimal", "high"],
            "DefaultReasoningEffort": "minimal"
          }
        }
      }
    }
  },
  "Prompts": {
    "DefaultSystemInstruction": "你是 AI Nexus，公司內部的文字助理。請使用繁體中文，清楚、精簡地回答。只根據使用者提供的內容與可靠常識，不要虛構來源。"
  },
  "Knowledge": {
    "Embedding": {
      "Provider": "google",
      "Model": "gemini-embedding-2",
      "Dimensions": 768,
      "TimeoutSeconds": 60,
      "MaxDailyRequests": 2000
    },
    "Indexing": {
      "MaxCollections": 30,
      "MaxDocumentsPerCollection": 100,
      "ChunkCharacters": 600,
      "ChunkOverlap": 80
    },
    "Retrieval": {
      "UseNativeVector": true,
      "PortableCandidateLimit": 2000,
      "TopK": 6,
      "ContextCharacters": 5000
    }
  },
  "Integrations": {
    "Sources": {
      "Gdweb": {
        "Enabled": false,
        "Transport": "sql",
        "AclContractConfirmed": false,
        "AllowedGroupIds": [],
        "CommandTimeoutSeconds": 10,
        "MaxResults": 30,
        "Database": {
          "Server": "",
          "Name": "",
          "TrustServerCertificate": false,
          "ConnectTimeoutSeconds": 10
        }
      },
      "Meiho": {
        "Enabled": false,
        "Transport": "sql",
        "AclContractConfirmed": false,
        "AllowedGroupIds": [],
        "CommandTimeoutSeconds": 10,
        "MaxResults": 30,
        "Database": {
          "Server": "",
          "Name": "",
          "TrustServerCertificate": false,
          "ConnectTimeoutSeconds": 10
        }
      }
    }
  },
  "Attachments": {
    "MaxOwnerBytes": 67108864,
    "MaxFileBytes": 4194304,
    "MaxMessageBytes": 8388608,
    "MaxFilesPerMessage": 4,
    "MaxExtractedCharacters": 64000,
    "MaxPdfPages": 40,
    "ImageTokenEstimate": 4096,
    "DraftRetentionDays": 14
  },
  "Exports": {
    "BrowserChannel": "msedge",
    "TimeoutSeconds": 30
  },
  "Storage": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Nexus": "",
    "LegacyGdweb": "",
    "LegacyMeiho": ""
  }
}
