{
  "ConfigurationVersion": 3,
  "AllowedHosts": "ai-nexus.company.internal",
  "Database": {
    "Server": "192.168.2.95",
    "Name": "AiNexus",
    "TrustServerCertificate": true,
    "ConnectTimeoutSeconds": 10
  },
  "AdAuthentication": {
    "Mode": "Ldap",
    "Url": "ad.company.internal/DC=company,DC=internal",
    "Domain": "company.internal",
    "DnUser": "CN=directory-reader,CN=Users,DC=company,DC=internal",
    "AdAccountAttrName": "sAMAccountName"
  },
  "Administration": {
    "BootstrapAdministrators": []
  },
  "DataProtection": {},
  "Security": {
    "DisableHttpsRedirection": false
  },
  "Inference": {
    "Execution": {
      "QueueCapacity": 16,
      "TimeoutSeconds": 300,
      "MaxInputCharacters": 12000,
      "MaxOutputCharacters": 65536
    },
    "ModelPolicy": {
      "AllowModelSelection": true,
      "ShowModelNames": true,
      "DefaultModelId": "google/gemma-4-26b-a4b-it"
    },
    "Providers": {
      "Google": {
        "Enabled": true,
        "MaxConcurrency": 1,
        "Models": {
          "default": {
            "Id": "gemma-4-26b-a4b-it",
            "DisplayName": "Gemma 4 · Google AI",
            "ContextTokens": 32768,
            "MaxOutputTokens": 4096,
            "SupportsStreaming": true,
            "SupportsUsage": true,
            "SupportsImages": true,
            "ReasoningControl": "google-level",
            "ReasoningEfforts": [
              "minimal",
              "high"
            ],
            "DefaultReasoningEffort": "minimal"
          }
        }
      },
      "Ollama": {
        "Enabled": false,
        "MaxConcurrency": 1,
        "Endpoint": "http://localhost:11434/",
        "Models": {
          "default": {
            "Id": "qwen3:8b",
            "DisplayName": "Qwen 3 · 本地",
            "ContextTokens": 8192,
            "MaxOutputTokens": 2048,
            "SupportsStreaming": true,
            "SupportsUsage": true,
            "SupportsImages": null,
            "ReasoningControl": "ollama-toggle",
            "ReasoningEfforts": [
              "minimal",
              "high"
            ],
            "DefaultReasoningEffort": "minimal"
          }
        }
      }
    }
  },
  "Prompts": {
    "DefaultSystemInstruction": "你是 AI Nexus，公司內部的文字助理。請使用繁體中文，清楚、精簡地回答。只根據使用者提供的內容與可靠常識，不要虛構來源。"
  },
  "Knowledge": {
    "Embedding": {
      "Provider": "ollama",
      "Model": "bge-m3",
      "Dimensions": 1024,
      "InputFormat": "plain",
      "QueryInstruction": "Given a web search query, retrieve relevant passages that answer the query",
      "Revision": "",
      "Endpoint": "",
      "TimeoutSeconds": 60,
      "MaxDailyRequests": 20000,
      "BatchSize": 16,
      "MaxConcurrentBatches": 1,
      "AutoActivate": false,
      "RetiredRetentionDays": 7
    },
    "Indexing": {
      "MaxCollections": 30,
      "MaxDocumentsPerCollection": 100,
      "ChunkTargetTokens": 450,
      "ChunkMaxTokens": 700,
      "ChunkMinTokens": 80,
      "ChunkOverlapRatio": 0.12
    },
    "Retrieval": {
      "Mode": "hybrid",
      "VectorCandidates": 40,
      "FtsCandidates": 40,
      "RrfK": 60,
      "VectorWeight": 1.0,
      "FtsWeight": 1.0,
      "RerankCandidates": 30,
      "TopK": 6,
      "MaxChunksPerDocument": 3,
      "MinVectorScore": 0,
      "ContextTokens": 3500,
      "QueryCacheMinutes": 10
    },
    "Rerank": {
      "Provider": "none",
      "Endpoint": "",
      "Model": "bge-reranker-v2-m3",
      "TimeoutSeconds": 10,
      "MinScore": 0.0,
      "FailurePolicy": "skip"
    },
    "QueryRewrite": {
      "Enabled": true,
      "MaxTurns": 4,
      "TimeoutSeconds": 5
    }
  },
  "Tools": {
    "WebSearch": {
      "Enabled": false,
      "Provider": "searxng",
      "Endpoint": "http://localhost:8080/",
      "TimeoutSeconds": 10,
      "MaxResults": 5,
      "MaxDailyRequests": 100
    }
  },
  "Integrations": {
    "Sources": {
      "Gdweb": {
        "Enabled": false,
        "Transport": "sql",
        "AclContractConfirmed": false,
        "AllowedGroupIds": [],
        "CommandTimeoutSeconds": 10,
        "MaxResults": 30,
        "Database": {
          "Server": "",
          "Name": "",
          "TrustServerCertificate": false,
          "ConnectTimeoutSeconds": 10
        }
      },
      "Meiho": {
        "Enabled": false,
        "Transport": "sql",
        "AclContractConfirmed": false,
        "AllowedGroupIds": [],
        "CommandTimeoutSeconds": 10,
        "MaxResults": 30,
        "Database": {
          "Server": "",
          "Name": "",
          "TrustServerCertificate": false,
          "ConnectTimeoutSeconds": 10
        }
      }
    },
    "Connectors": {
      "Gitea": {
        "Enabled": false,
        "BaseUrl": "https://gitea.hanglong.com.tw/",
        "TimeoutSeconds": 10,
        "MaxFileBytes": 200000
      }
    }
  },
  "Attachments": {
    "StoragePath": "D:\\CoreProject\\AiNexus\\data\\attachments",
    "DefaultOwnerLimitBytes": 5000000000,
    "MaxFileBytes": 4194304,
    "MaxMessageBytes": 8388608,
    "MaxFilesPerMessage": 4,
    "MaxExtractedCharacters": 64000,
    "MaxPdfPages": 40,
    "ImageTokenEstimate": 4096,
    "DraftRetentionDays": 14,
    "CleanupIntervalMinutes": 60
  },
  "Exports": {
    "BrowserChannel": "msedge",
    "BrowserExecutablePath": "",
    "TimeoutSeconds": 30
  },
  "Storage": {
    "ApplyMigrationsOnStartup": false
  },
  "Diagnostics": {
    "Directory": "D:/CoreProject/AiNexus/data/diagnostics",
    "ServiceName": "AiNexus",
    "MinimumLevel": "Information",
    "FrameworkMinimumLevel": "Warning",
    "QueueCapacity": 8192,
    "ImportantQueueCapacity": 2048,
    "BatchSize": 200,
    "FlushIntervalMs": 1000,
    "RetrySeconds": 10,
    "SqlTimeoutSeconds": 5,
    "ShutdownSeconds": 10,
    "FileSizeBytes": 16777216,
    "MaxDiskBytes": 2147483648,
    "MaxSqlRows": 5000000,
    "FileRetentionDays": 14,
    "RetentionDays": 30,
    "AuditRetentionDays": 365,
    "CleanupBatchSize": 1000,
    "LowLevelSampleEvery": 1,
    "MaxQueryDays": 31,
    "MaxExportRows": 5000,
    "MaxExportDays": 7,
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://localhost:4318"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Nexus": "",
    "LegacyGdweb": "",
    "LegacyMeiho": ""
  }
}
