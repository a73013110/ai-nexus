<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Host only: configuration, middleware pipeline, module composition and operational commands. -->
  <PropertyGroup>
    <RootNamespace>AiNexus.Api</RootNamespace>
    <UserSecretsId>ai-nexus-api-v1-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AiNexus.Platform/AiNexus.Platform.csproj" />
    <ProjectReference Include="../AiNexus.Features/AiNexus.Features.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Secrets.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Staging.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.*.example.json" CopyToPublishDirectory="Never" />
    <Content Update="web.config" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
