<Project Sdk="Microsoft.NET.Sdk">
  <!-- 業務模組（Features/<Area>/<Module>/...）；資料表與 DbContext 在 AiNexus.Data。 -->
  <PropertyGroup>
    <RootNamespace>AiNexus.Features</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AiNexus.Platform/AiNexus.Platform.csproj" />
    <ProjectReference Include="../AiNexus.Data/AiNexus.Data.csproj" />
    <!-- 編譯期產生模組組合（FeatureModules）；只當分析器載入，不引用組件、不進發布輸出。 -->
    <ProjectReference Include="../AiNexus.Generators/AiNexus.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- 常見密碼清單（來源與授權見同目錄的 common-passwords.LICENSE.txt）。 -->
    <EmbeddedResource Include="Admin/Identity/SelfService/common-passwords.txt" LogicalName="AiNexus.Features.Admin.Identity.SelfService.common-passwords.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
</Project>
