{
  "name": "ai-nexus",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint src",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "contracts": "openapi-typescript ../contracts/openapi.json -o src/app/core/api/schema.ts --root-types --root-types-no-schema-prefix && node scripts/generate-feature-catalog.mjs && node scripts/generate-public-errors.mjs",
    "contracts:check": "openapi-typescript ../contracts/openapi.json -o src/app/core/api/schema.ts --root-types --root-types-no-schema-prefix --check && node scripts/generate-feature-catalog.mjs --check && node scripts/generate-public-errors.mjs --check"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": "26.5.0",
    "npm": "11.6.1"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "lucide": "1.63.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.2"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
